<!DOCTYPE html>
<html>
<head>
    <title>Social Media App</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        .post { border: 1px solid #ddd; padding: 15px; margin-top: 10px; border-radius: 5px; }
    </style>
</head>
<body>
    <h1>Mini Social Media App</h1>
    
    <h3>Create a Post</h3>
    <form action="/create-post" method="POST">
        <input type="text" name="username" placeholder="Your Name" required><br><br>
        <textarea name="content" placeholder="What's on your mind?" required></textarea><br><br>
        <button type="submit">Post</button>
    </form>

    <h2>Feed</h2>
    <% posts.forEach(post => { %>
        <div class="post">
            <h4>@<%= post.user %></h4>
            <p><%= post.content %></p>
            <form action="/like/<%= post.id %>" method="POST">
                <button type="submit">❤️ Like (<%= post.likes %>)</button>
            </form>
        </div>
    <% }) %>
</body>
</html>